{
	"name": "celestie",
	"version": "0.0.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.2",
		"@types/shell-quote": "^1.7.5",
		"electron": "^45.2.1",
		"electron-builder": "^26.18.0",
		"esbuild": "^0.28.2",
		"sass": "^1.100.0",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vite-plugin-solid": "^2.11.14"
	},
	"private": true,
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"desktop:dev": "bun run scripts/desktop.ts --dev",
		"desktop:build": "bun run build && tsc -p tsconfig.electron.json && bun run scripts/desktop.ts",
		"desktop:start": "electron .",
		"desktop:package": "bun run desktop:build && electron-builder"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/sora": "^5.3.0",
		"@nightnetwork/dusk": "1.0.1",
		"@solidjs/meta": "^0.29.4",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"buffer": "^6.0.3",
		"chalk": "^6.0.1",
		"isomorphic-git": "^1.44.8",
		"node-pty": "^1.1.0",
		"prettier": "^3.9.10",
		"shell-quote": "^1.12.0",
		"solid-js": "^1.9.17"
	},
	"main": "dist-electron/main.mjs",
	"trustedDependencies": [
		"electron",
		"node-pty"
	],
	"description": "A security-focused IDE for the browser and desktop.",
	"author": "Sylvia Calabrese",
	"license": "AGPL-3.0-only"
}
